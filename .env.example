# Safe local-development defaults. Copy to .env and change as needed.
POSTGRES_DB=tuck
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
POSTGRES_USER=tuck
TUCK_DATABASE_URL=postgresql+asyncpg://tuck:local-development-only@localhost:5432/tuck
TUCK_COMPOSE_DATABASE_URL=postgresql+asyncpg://tuck:local-development-only@postgres:5432/tuck
TUCK_ENVIRONMENT=development
TUCK_VAPID_PUBLIC_KEY=
TUCK_VAPID_PRIVATE_KEY=
TUCK_VAPID_SUBJECT=
TUCK_NOTIFICATION_WORKER_POLL_SECONDS=5
TUCK_NOTIFICATION_WORKER_LEASE_SECONDS=300
TUCK_NOTIFICATION_WORKER_BATCH_SIZE=100
TUCK_NOTIFICATION_WORKER_MAX_ATTEMPTS=5
